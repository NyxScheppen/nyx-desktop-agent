:{$PORT:8080} {
    encode gzip

    handle /api/* {
        reverse_proxy {$NYX_BACKEND_URL} {
            header_up Host nyx-frontend-production.up.railway.app
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
