{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyx",
  "version": "0.1.0",
  "identifier": "com.nyx.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nyx",
        "width": 560,
        "height": 520,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "alwaysOnBottom": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["../../build/sidecar/nyx-backend/nyx-backend"],
    "resources": {
      "../../build/sidecar/nyx-backend/_internal/": "_internal/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
